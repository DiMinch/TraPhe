# ===== Database (Supabase PostgreSQL) =====
DB_PASSWORD=your_supabase_db_password

# ===== JWT Authentication =====
JWT_SECRET=your-256-bit-secret-key-change-in-production

# ===== Supabase Storage =====
SUPABASE_URL=https://irzskouxozoygfjbgkuq.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ===== Redis (Upstash free tier or local) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ===== Mail (Mailtrap sandbox) =====
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== VNPAY Sandbox =====
VNPAY_TMN_CODE=DEMOV210
VNPAY_HASH_SECRET=your_vnpay_hash_secret_key_here
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/order/payment-callback

# ===== MoMo Sandbox =====
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
